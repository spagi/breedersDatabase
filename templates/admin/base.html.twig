{% extends 'base.html.twig' %}

{% block body %}
<div class="admin-layout">
    {# Sidebar #}
    <aside class="admin-sidebar">
        <div class="admin-sidebar-title">Admin</div>
        <a href="{{ path('admin_dashboard') }}" class="{{ app.request.attributes.get('_route') == 'admin_dashboard' ? 'active' : '' }}">
            📊 {{ 'admin.dashboard'|trans }}
        </a>
        <a href="{{ path('admin_users') }}" class="{{ app.request.attributes.get('_route') starts with 'admin_user' ? 'active' : '' }}">
            👤 {{ 'admin.users'|trans }}
        </a>
        <a href="{{ path('admin_kennels') }}" class="{{ app.request.attributes.get('_route') starts with 'admin_kennel' ? 'active' : '' }}">
            🏡 {{ 'admin.kennels'|trans }}
        </a>
        <a href="{{ path('admin_breeds') }}" class="{{ app.request.attributes.get('_route') starts with 'admin_breed' ? 'active' : '' }}">
            🐕 {{ 'admin.breeds'|trans }}
        </a>
        <div style="margin-top:auto;border-top:1px solid rgba(255,255,255,.1);padding-top:1rem;margin-top:2rem;">
            <a href="{{ path('app_home') }}">← Zpět na web</a>
        </div>
    </aside>

    {# Content #}
    <main class="admin-content">
        {% block admin_body %}{% endblock %}
    </main>
</div>
{% endblock %}
