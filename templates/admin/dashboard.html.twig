{% extends 'admin/base.html.twig' %}
{% block title %}Admin Dashboard{% endblock %}

{% block admin_body %}
<h1 style="color:var(--color-forest-dark);margin-bottom:2rem;">📊 {{ 'admin.dashboard'|trans }}</h1>

<div class="dashboard-grid">
    <div class="stat-card">
        <div class="stat-card-icon stat-card-icon-blue">👤</div>
        <div>
            <div class="stat-card-value">{{ totalUsers }}</div>
            <div class="stat-card-label">{{ 'admin.total_users'|trans }}</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card-icon stat-card-icon-green">🏡</div>
        <div>
            <div class="stat-card-value">{{ totalKennels }}</div>
            <div class="stat-card-label">{{ 'admin.total_kennels'|trans }}</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card-icon stat-card-icon-amber">🐕</div>
        <div>
            <div class="stat-card-value">{{ totalBreeds }}</div>
            <div class="stat-card-label">{{ 'admin.total_breeds'|trans }}</div>
        </div>
    </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-top:1rem;">
    <div style="background:#fff;border-radius:var(--radius-xl);box-shadow:var(--shadow-card);padding:1.5rem;">
        <h3 style="color:var(--color-forest-dark);margin-bottom:1rem;">Rychlý přístup</h3>
        <div style="display:flex;flex-direction:column;gap:.6rem;">
            <a href="{{ path('admin_users') }}" class="btn btn-secondary" style="justify-content:flex-start;">👤 Správa uživatelů</a>
            <a href="{{ path('admin_kennels') }}" class="btn btn-secondary" style="justify-content:flex-start;">🏡 Správa stanic</a>
            <a href="{{ path('admin_breeds') }}" class="btn btn-secondary" style="justify-content:flex-start;">🐕 Správa plemen</a>
            <a href="{{ path('admin_breed_new') }}" class="btn btn-primary" style="justify-content:flex-start;">+ Přidat plemeno</a>
        </div>
    </div>
</div>
{% endblock %}
