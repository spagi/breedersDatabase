{% extends 'base.html.twig' %}
{% block title %}{{ title|trans }}{% endblock %}
{% block body %}
<div style="background:linear-gradient(135deg,var(--color-forest-dark) 0%,var(--color-forest) 100%);padding:2.5rem 1.5rem 2rem;color:#fff;text-align:center;">
    <h1 style="color:#fff;">🐕 {{ title|trans }}</h1>
</div>
<div class="section" style="max-width:600px;margin:0 auto;">
    <div class="form-card" style="max-width:600px;">
        {{ form_start(form) }}
            <div class="form-group">
                {{ form_label(form.name, null, {label_attr: {class: 'form-label'}}) }}
                {{ form_widget(form.name) }}
                {{ form_errors(form.name) }}
            </div>
            <div class="form-grid">
                <div class="form-group">
                    {{ form_label(form.gender, null, {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.gender) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.breed, null, {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.breed) }}
                </div>
            </div>
            <div class="form-grid">
                <div class="form-group">
                    {{ form_label(form.bornAt, null, {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.bornAt) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.titles, null, {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.titles) }}
                </div>
            </div>
            <div class="form-grid">
                <div class="form-group">
                    {{ form_label(form.registrationNumber, null, {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.registrationNumber) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.chipNumber, null, {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.chipNumber) }}
                </div>
            </div>
            <div class="form-check mb-2">
                {{ form_widget(form.isStud) }}
                {{ form_label(form.isStud, null, {label_attr: {style: 'font-size:.9rem;'}}) }}
            </div>
            <div class="form-group">
                {{ form_label(form.description, null, {label_attr: {class: 'form-label'}}) }}
                {{ form_widget(form.description) }}
            </div>
            <div style="display:flex;gap:1rem;justify-content:flex-end;margin-top:1.5rem;">
                <a href="{{ path('app_dashboard') }}" class="btn btn-secondary">{{ 'form.cancel'|trans }}</a>
                <button type="submit" class="btn btn-primary">{{ 'form.save'|trans }}</button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
