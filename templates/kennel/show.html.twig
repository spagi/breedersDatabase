{% extends 'base.html.twig' %}

{% block title %}{{ kennel.name }}{% endblock %}

{% block body %}

{# ── Kennel Hero ── #}
<div class="kennel-hero">
    <div class="kennel-hero-content">
        <div class="kennel-logo">
            {% if kennel.logoFilename %}
                <img src="/uploads/logos/{{ kennel.logoFilename }}" alt="{{ kennel.name }}">
            {% else %}
                🐾
            {% endif %}
        </div>
        <div class="kennel-hero-info" style="flex:1;">
            <h1>{{ kennel.name }}</h1>
            <div class="kennel-hero-badges">
                {% if kennel.isVerified %}
                    <span class="badge badge-verified">✓ {{ 'kennel.verified'|trans }}</span>
                {% endif %}
                {% for breed in kennel.breeds %}
                    <span class="badge badge-green">{{ breed.getName(app.request.locale) }}</span>
                {% endfor %}
                {% if kennel.purposes %}
                    {% for p in kennel.purposes %}
                        <span class="badge badge-amber">{{ ('kennel.purpose.' ~ p)|trans }}</span>
                    {% endfor %}
                {% endif %}
            </div>
            <div class="kennel-hero-meta">
                {% if kennel.location %}
                    <span>📍 {{ kennel.location }}</span>
                {% endif %}
                <span>🐕 {{ kennel.dogs|length }} {{ 'kennel.dogs'|trans }}</span>
                <span>🐣 {{ kennel.litters|length }} {{ 'kennel.litters'|trans }}</span>
            </div>
        </div>
        {% if is_granted('ROLE_USER') and app.user.kennel == kennel %}
            <div>
                <a href="{{ path('app_kennel_edit') }}" class="btn btn-amber">✏️ {{ 'kennel.edit_profile'|trans }}</a>
            </div>
        {% endif %}
    </div>
</div>

{# ── Tabs ── #}
<div class="tabs">
    <div class="tabs-inner">
        <a href="#about" class="tab-link active" id="tab-about">{{ 'footer.about'|trans }}</a>
        <a href="#dogs" class="tab-link" id="tab-dogs">{{ 'kennel.dogs'|trans }} ({{ kennel.dogs|length }})</a>
        <a href="#litters" class="tab-link" id="tab-litters">{{ 'kennel.litters'|trans }} ({{ kennel.litters|length }})</a>
        <a href="#contact" class="tab-link" id="tab-contact">{{ 'kennel.contact'|trans }}</a>
    </div>
</div>

{# ── Content ── #}
<div class="section" style="max-width:1280px;margin:0 auto;">
    <div style="display:grid;grid-template-columns:2fr 1fr;gap:2rem;align-items:start;" id="kennel-content">

        {# Left column #}
        <div>
            {# About #}
            <section id="about">
                <h2 class="section-title mb-2">{{ 'footer.about'|trans }}</h2>
                {% set desc = kennel.getDescription(app.request.locale) %}
                {% if desc %}
                    <div style="line-height:1.8;color:var(--color-text);">{{ desc|nl2br }}</div>
                {% else %}
                    <p class="text-muted">Chovatelská stanice nemá zatím popis.</p>
                {% endif %}
            </section>

            {# Dogs #}
            <section id="dogs" class="mt-4">
                <h2 class="section-title mb-2">{{ 'kennel.dogs'|trans }}</h2>
                {% if kennel.dogs is empty %}
                    <div class="empty-state" style="padding:2rem 0;">
                        <div class="empty-state-icon" style="font-size:2.5rem;">🐕</div>
                        <p>{{ 'kennel.no_dogs'|trans }}</p>
                    </div>
                {% else %}
                    <div class="dog-grid">
                        {% for dog in kennel.dogs %}
                            <div class="dog-card">
                                <div class="dog-card-photo">
                                    {% if dog.photoFilename %}
                                        <img src="/uploads/dogs/{{ dog.photoFilename }}" alt="{{ dog.name }}">
                                    {% else %}
                                        {{ dog.isMale ? '🐕' : '🐩' }}
                                    {% endif %}
                                </div>
                                <div class="dog-card-body">
                                    <div class="dog-card-name">
                                        {% if dog.titles %}<small style="color:var(--color-amber);font-size:.75rem;">{{ dog.titles }}</small><br>{% endif %}
                                        {{ dog.name }}
                                    </div>
                                    <div class="dog-card-meta">
                                        <span>{{ dog.breed.getName(app.request.locale) }}</span>
                                        <span>{{ dog.isMale ? '♂' : '♀' }}</span>
                                        {% if dog.getAge() is not null %}<span>{{ dog.getAge() }}r.</span>{% endif %}
                                        {% if dog.isStud %}<span class="badge badge-amber" style="font-size:.7rem;">Krytí</span>{% endif %}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </section>

            {# Litters #}
            <section id="litters" class="mt-4">
                <h2 class="section-title mb-2">{{ 'kennel.litters'|trans }}</h2>
                {% if kennel.litters is empty %}
                    <div class="empty-state" style="padding:2rem 0;">
                        <div class="empty-state-icon" style="font-size:2.5rem;">🐣</div>
                        <p>{{ 'kennel.no_litters'|trans }}</p>
                    </div>
                {% else %}
                    <div style="display:flex;flex-direction:column;gap:1rem;">
                        {% for litter in kennel.litters %}
                            <div class="litter-card">
                                <div class="litter-card-side"></div>
                                <div class="litter-card-body">
                                    <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:.5rem;">
                                        <div>
                                            <h3 class="litter-title">
                                                {{ litter.title }}
                                                {% if litter.isPlanned %}<span class="badge badge-blue" style="margin-left:.5rem;">Plánovaný</span>{% endif %}
                                            </h3>
                                            {% if litter.mother or litter.father %}
                                                <p class="text-muted" style="font-size:.83rem;margin:.25rem 0;">
                                                    {% if litter.mother %}♀ {{ litter.mother.name }}{% endif %}
                                                    {% if litter.mother and litter.father %} × {% endif %}
                                                    {% if litter.father %}♂ {{ litter.father.name }}{% endif %}
                                                </p>
                                            {% endif %}
                                        </div>
                                        <div style="display:flex;gap:.5rem;">
                                            {% if litter.hasPuppiesAvailable %}
                                                <span class="badge badge-amber">🐶 Štěňata k dispozici</span>
                                            {% endif %}
                                            <a href="{{ path('app_litter_show', {id: litter.id}) }}" class="btn btn-sm btn-secondary">Zobrazit</a>
                                        </div>
                                    </div>
                                    <div class="litter-stats">
                                        <div class="litter-stat"><span class="litter-stat-num">{{ litter.malePuppies }}</span><span>♂</span></div>
                                        <div class="litter-stat"><span class="litter-stat-num">{{ litter.femalePuppies }}</span><span>♀</span></div>
                                        <div class="litter-stat"><span class="litter-stat-num">{{ litter.totalPuppies }}</span><span>celkem</span></div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </section>
        </div>

        {# Right sidebar - Contact #}
        <div id="contact" style="position:sticky;top:130px;">
            <div style="background:#fff;border-radius:var(--radius-xl);box-shadow:var(--shadow-card);padding:1.5rem;">
                <h3 style="font-size:1.1rem;color:var(--color-forest-dark);margin-bottom:1.25rem;padding-bottom:.75rem;border-bottom:2px solid var(--color-cream-dark);">
                    {{ 'kennel.contact'|trans }}
                </h3>
                <div style="display:flex;flex-direction:column;gap:.75rem;">
                    {% if kennel.phone %}
                        <div style="display:flex;align-items:center;gap:.75rem;">
                            <span style="font-size:1.25rem;">📞</span>
                            <a href="tel:{{ kennel.phone }}" style="color:var(--color-forest);font-weight:600;">{{ kennel.phone }}</a>
                        </div>
                    {% endif %}
                    {% if kennel.email %}
                        <div style="display:flex;align-items:center;gap:.75rem;">
                            <span style="font-size:1.25rem;">✉️</span>
                            <a href="mailto:{{ kennel.email }}" style="color:var(--color-forest);">{{ kennel.email }}</a>
                        </div>
                    {% endif %}
                    {% if kennel.website %}
                        <div style="display:flex;align-items:center;gap:.75rem;">
                            <span style="font-size:1.25rem;">🌐</span>
                            <a href="{{ kennel.website }}" target="_blank" rel="noopener" style="color:var(--color-forest);">Web</a>
                        </div>
                    {% endif %}
                    {% if kennel.facebook %}
                        <div style="display:flex;align-items:center;gap:.75rem;">
                            <span style="font-size:1.25rem;">📘</span>
                            <a href="{{ kennel.facebook }}" target="_blank" rel="noopener" style="color:var(--color-forest);">Facebook</a>
                        </div>
                    {% endif %}
                    {% if kennel.instagram %}
                        <div style="display:flex;align-items:center;gap:.75rem;">
                            <span style="font-size:1.25rem;">📷</span>
                            <a href="{{ kennel.instagram }}" target="_blank" rel="noopener" style="color:var(--color-forest);">Instagram</a>
                        </div>
                    {% endif %}
                    {% if kennel.location %}
                        <div style="display:flex;align-items:flex-start;gap:.75rem;margin-top:.5rem;padding-top:.75rem;border-top:1px solid var(--color-cream-dark);">
                            <span style="font-size:1.25rem;">📍</span>
                            <div>
                                {% if kennel.city %}<strong>{{ kennel.city }}</strong><br>{% endif %}
                                {% if kennel.region %}{{ kennel.region }}<br>{% endif %}
                                {% if kennel.country %}{{ kennel.country }}{% endif %}
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}
