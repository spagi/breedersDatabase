{% extends 'base.html.twig' %}
{% block title %}{{ 'kennel.create_new'|trans }}{% endblock %}
{% block body %}
<div style="background:linear-gradient(135deg,var(--color-forest-dark) 0%,var(--color-forest) 100%);padding:2.5rem 1.5rem 2rem;color:#fff;text-align:center;">
    <h1 style="color:#fff;">🏡 {{ 'kennel.create_new'|trans }}</h1>
</div>
<div class="section" style="max-width:860px;margin:0 auto;">
    <div class="form-card form-card-wide">
        {{ form_start(form) }}
            <h3 class="form-section-title">Základní informace</h3>
            <div class="form-group">
                {{ form_label(form.name, null, {label_attr: {class: 'form-label'}}) }}
                {{ form_widget(form.name) }}
                {{ form_errors(form.name) }}
            </div>

            <div class="form-group">
                {{ form_label(form.breeds, null, {label_attr: {class: 'form-label'}}) }}
                {{ form_widget(form.breeds, {attr: {size: 8, style: 'height:auto;'}}) }}
                <small class="text-muted">Podržte Ctrl pro výběr více plemen</small>
                {{ form_errors(form.breeds) }}
            </div>

            <div class="form-group">
                <span class="form-label">{{ 'kennel.purposes'|trans }}</span>
                <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:.5rem;margin-top:.5rem;">
                    {{ form_widget(form.purposes) }}
                </div>
            </div>

            <h3 class="form-section-title">Popis stanice</h3>
            <div class="form-group">
                {{ form_label(form.descriptionCz, null, {label_attr: {class: 'form-label'}}) }}
                {{ form_widget(form.descriptionCz) }}
            </div>
            <div class="form-group">
                {{ form_label(form.descriptionEn, null, {label_attr: {class: 'form-label'}}) }}
                {{ form_widget(form.descriptionEn) }}
            </div>
            <div class="form-group">
                {{ form_label(form.descriptionSk, null, {label_attr: {class: 'form-label'}}) }}
                {{ form_widget(form.descriptionSk) }}
            </div>

            <h3 class="form-section-title">Lokalita</h3>
            <div class="form-grid">
                <div class="form-group">
                    {{ form_label(form.city, null, {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.city) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.region, null, {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.region) }}
                </div>
            </div>
            <div class="form-group">
                {{ form_label(form.country, null, {label_attr: {class: 'form-label'}}) }}
                {{ form_widget(form.country) }}
            </div>

            <h3 class="form-section-title">Kontakt</h3>
            <div class="form-grid">
                <div class="form-group">
                    {{ form_label(form.phone, null, {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.phone) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.email, null, {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.email) }}
                </div>
            </div>
            <div class="form-group">
                {{ form_label(form.website, null, {label_attr: {class: 'form-label'}}) }}
                {{ form_widget(form.website) }}
            </div>
            <div class="form-grid">
                <div class="form-group">
                    {{ form_label(form.facebook, null, {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.facebook) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.instagram, null, {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.instagram) }}
                </div>
            </div>

            <div style="display:flex;gap:1rem;justify-content:flex-end;margin-top:1.5rem;">
                <a href="{{ path('app_dashboard') }}" class="btn btn-secondary">{{ 'form.cancel'|trans }}</a>
                <button type="submit" class="btn btn-primary">{{ 'form.save'|trans }}</button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
