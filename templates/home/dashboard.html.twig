{% extends 'base.html.twig' %}

{% block title %}{{ 'dashboard.title'|trans }}{% endblock %}

{% block body %}
<div style="background:linear-gradient(135deg,var(--color-forest-dark) 0%,var(--color-forest) 100%);color:#fff;padding:2.5rem 1.5rem 2rem;">
    <div style="max-width:1280px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;">
        <div>
            <h1 style="color:#fff;margin-bottom:.25rem;">{{ 'dashboard.title'|trans }}</h1>
            <p style="color:rgba(255,255,255,.7);margin:0;">{{ user.fullName }}</p>
        </div>
        {% if kennel %}
            <div style="display:flex;gap:.75rem;flex-wrap:wrap;">
                <a href="{{ path('app_kennel_edit') }}" class="btn btn-secondary">✏️ {{ 'dashboard.edit_profile'|trans }}</a>
                <a href="{{ path('app_dog_new') }}" class="btn btn-amber">+ {{ 'kennel.add_dog'|trans }}</a>
                <a href="{{ path('app_litter_new') }}" class="btn btn-amber">+ {{ 'kennel.add_litter'|trans }}</a>
            </div>
        {% endif %}
    </div>
</div>

<div class="section" style="max-width:1280px;margin:0 auto;">
    {% if not kennel %}
        <div class="form-card" style="text-align:center;">
            <div style="font-size:4rem;margin-bottom:1rem;">🏡</div>
            <h2>{{ 'dashboard.no_kennel'|trans }}</h2>
            <p class="text-muted">Zaregistrujte svoji chovatelskou stanici a získejte veřejný profil.</p>
            <a href="{{ path('app_kennel_new') }}" class="btn btn-primary btn-lg mt-2">
                + {{ 'dashboard.create_kennel'|trans }}
            </a>
        </div>
    {% else %}
        {# Stats #}
        <div class="dashboard-grid">
            <div class="stat-card">
                <div class="stat-card-icon stat-card-icon-green">🐕</div>
                <div>
                    <div class="stat-card-value">{{ kennel.dogs|length }}</div>
                    <div class="stat-card-label">{{ 'kennel.dogs'|trans }}</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-card-icon stat-card-icon-amber">🐣</div>
                <div>
                    <div class="stat-card-value">{{ kennel.litters|length }}</div>
                    <div class="stat-card-label">{{ 'kennel.litters'|trans }}</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-card-icon stat-card-icon-blue">📸</div>
                <div>
                    <div class="stat-card-value">{{ kennel.photos|length }}</div>
                    <div class="stat-card-label">{{ 'kennel.gallery'|trans }}</div>
                </div>
            </div>
        </div>

        {# Dogs #}
        <div class="section-header">
            <h2 class="section-title">{{ 'dashboard.my_dogs'|trans }}</h2>
            <a href="{{ path('app_dog_new') }}" class="btn btn-sm btn-primary">+ {{ 'kennel.add_dog'|trans }}</a>
        </div>

        {% if kennel.dogs is empty %}
            <div class="empty-state">
                <div class="empty-state-icon">🐕</div>
                <h3>{{ 'kennel.no_dogs'|trans }}</h3>
            </div>
        {% else %}
            <div class="dog-grid mb-4">
                {% for dog in kennel.dogs %}
                    <div class="dog-card">
                        <div class="dog-card-photo">
                            {% if dog.photoFilename %}
                                <img src="/uploads/dogs/{{ dog.photoFilename }}" alt="{{ dog.name }}">
                            {% else %}
                                {{ dog.isMale ? '🐕' : '🐩' }}
                            {% endif %}
                        </div>
                        <div class="dog-card-body">
                            <div class="dog-card-name">{{ dog.name }}</div>
                            <div class="dog-card-meta">
                                <span>{{ dog.breed.getName(app.request.locale) }}</span>
                                {% if dog.titles %}<span>🏆 {{ dog.titles }}</span>{% endif %}
                                {% if dog.getAge() is not null %}<span>{{ dog.getAge() }}r.</span>{% endif %}
                            </div>
                            <div class="mt-1">
                                <a href="{{ path('app_dog_edit', {id: dog.id}) }}" class="btn btn-sm btn-secondary">✏️</a>
                                {% if dog.isStud %}<span class="badge badge-amber" style="margin-left:.4rem;">♂ Krytí</span>{% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        {# Litters #}
        <div class="section-header">
            <h2 class="section-title">{{ 'dashboard.my_litters'|trans }}</h2>
            <a href="{{ path('app_litter_new') }}" class="btn btn-sm btn-primary">+ {{ 'kennel.add_litter'|trans }}</a>
        </div>

        {% if kennel.litters is empty %}
            <div class="empty-state">
                <div class="empty-state-icon">🐣</div>
                <h3>{{ 'kennel.no_litters'|trans }}</h3>
            </div>
        {% else %}
            <div style="display:flex;flex-direction:column;gap:1rem;">
                {% for litter in kennel.litters %}
                    <div class="litter-card">
                        <div class="litter-card-side"></div>
                        <div class="litter-card-body" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;">
                            <div>
                                <h3 class="litter-title">
                                    {{ litter.title }}
                                    {% if litter.isPlanned %}<span class="badge badge-blue" style="margin-left:.5rem;">Plánovaný</span>{% endif %}
                                    {% if litter.hasPuppiesAvailable %}<span class="badge badge-amber" style="margin-left:.3rem;">Štěňata k dispozici</span>{% endif %}
                                </h3>
                                <div class="litter-stats" style="margin:0;">
                                    <div class="litter-stat"><span class="litter-stat-num">{{ litter.malePuppies }}</span><span>♂</span></div>
                                    <div class="litter-stat"><span class="litter-stat-num">{{ litter.femalePuppies }}</span><span>♀</span></div>
                                    <div class="litter-stat"><span class="litter-stat-num">{{ litter.totalPuppies }}</span><span>total</span></div>
                                </div>
                            </div>
                            <div style="display:flex;gap:.5rem;flex-wrap:wrap;">
                                <a href="{{ path('app_litter_show', {id: litter.id}) }}" class="btn btn-sm btn-secondary">👁 Zobrazit</a>
                                <a href="{{ path('app_litter_edit', {id: litter.id}) }}" class="btn btn-sm btn-secondary">✏️ Upravit</a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        <div class="mt-4" style="text-align:center;">
            <a href="{{ path('app_kennel_show', {slug: kennel.slug}) }}" class="btn btn-primary btn-lg">
                🔗 {{ 'kennel.edit_profile'|trans }} — zobrazit veřejný profil
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}
